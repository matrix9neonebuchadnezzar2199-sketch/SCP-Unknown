{
  "rules": {
    "chat": {
      "all": {
        ".read": true,
        ".write": "auth != null",
        ".indexOn": ["ts"]
      },
      "question": {
        ".read": true,
        ".write": "auth != null",
        ".indexOn": ["ts"]
      }
    },
    "saves": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        "$conn": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['ts']) && newData.child('ts').isNumber()"
        }
      }
    }
  }
}
